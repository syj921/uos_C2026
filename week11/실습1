
#include <stdio.h>
#include <string.h>

int main(void)
{
    char str[100];
    char* p;
    int count = 0;

    printf("영문 문장을 입력하시오 : ");

    if (fgets(str, sizeof(str), stdin) == NULL) {
        return 1;
    }

    str[strcspn(str, "\n")] = '\0';

    for (p = str; *p != '\0'; p++) {

        // 대문자를 소문자로 변환
        if (*p >= 'A' && *p <= 'Z') {
            *p = *p - 'A' + 'a';
        }

        if (*p != ' ') {
            count++;
        }
    }

    printf("소문자 : %s\n", str);
    printf("글자 수 (공백 제외) : %d\n", count);

    return 0;
}
